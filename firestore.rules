rules_version = '2';
// Firestore 安全规则（Firebase Auth · 阶段一：必须登录）
// - 仅允许「已登录且带邮箱的用户」读写（合成邮箱账户 <name>@trip.local）。
// - request.auth.token.email != null 可排除匿名登录（匿名用户无邮箱）。
// - 阶段二将基于 members + 自定义声明 username 做「公开/私密」与成员级隔离。
//
// 数据模型：
//   trips/{tripId}/days/{dayId}       行程（按天文档，items 为 map）
//   trips/{tripId}/backup/{key}       软删除备份
//   trips/{tripId}/sections/{key}     行前/行后各功能区数据
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInUser() {
      return request.auth != null && request.auth.token.email != null;
    }

    match /trips/{tripId} {
      allow read, write: if signedInUser();
      match /{document=**} {
        allow read, write: if signedInUser();
      }
    }
  }
}
